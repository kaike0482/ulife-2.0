```mermaid
sequenceDiagram
    autonumber
    actor Usuario
    participant Principal as TelaPrincipal
    participant DAO as MaterialDAO / AtividadeDAO
    participant DB as MySQL

    Usuario->>Principal: Seleciona seção (Aulas/Materiais)
    Principal->>DAO: listarPorTurma(turmaId) / listarPorTurma(turmaId)
    DAO->>DB: SELECT * FROM MATERIAL WHERE turma_id = ? ORDER BY data_publicacao DESC
    DB-->>DAO: Lista de materiais
    DAO-->>Principal: List<Material> / List<Atividade>
    Principal-->>Usuario: Exibe lista no painel (abas/quadro)

    alt Perfil = Professor
        Usuario->>Principal: Clica "Publicar Material" ou "Publicar Atividade"
        Principal->>Usuario: Abre formulário (título, descrição, arquivo, data entrega/peso)
        Usuario->>Principal: Preenche e clica "Salvar"
        Principal->>DAO: inserir(material/atividade)
        DAO->>DB: INSERT INTO MATERIAL/ATIVIDADE ...
        DB-->>DAO: OK (ID gerado)
        DAO-->>Principal: Sucesso
        Principal-->>Usuario: Feedback + lista atualizada
    end

    alt Perfil = Aluno e seção = Atividades
        Usuario->>Principal: Clica "Entregar" em atividade pendente
        Principal->>Usuario: Abre diálogo de upload
        Usuario->>Principal: Seleciona arquivo e confirma
        Principal->>EntregaDAO: inserir(atividadeId, matriculaId, arquivoUrl)
        EntregaDAO->>DB: INSERT INTO ENTREGA ...
        DB-->>EntregaDAO: OK
        EntregaDAO-->>Principal: Entrega criada
        Principal-->>Usuario: Status altera para "Entregue"
    end

    alt Perfil = Professor e seção = Atividades
        Usuario->>Principal: Clica "Corrigir" em entrega
        Principal->>Usuario: Abre arquivo + campos nota/comentário
        Usuario->>Principal: Preenche nota e comentário, clica "Salvar"
        Principal->>AvaliacaoDAO: inserir(entregaId, nota, comentario)
        AvaliacaoDAO->>DB: INSERT INTO AVALIACAO_ENTREGA ...
        AvaliacaoDAO->>DB: UPDATE ENTREGA SET status = 'CORRIGIDA'
        DB-->>AvaliacaoDAO: OK
        AvaliacaoDAO-->>Principal: Avaliação salva
        Principal-->>Usuario: Entrega marcada como corrigida
    end
```